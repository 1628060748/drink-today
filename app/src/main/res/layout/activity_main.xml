<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/pageToday"
            layout="@layout/page_today" />

        <include
            android:id="@+id/pageHistory"
            layout="@layout/page_history" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nav"
        android:elevation="12dp">

        <View
            android:id="@+id/navIndicator"
            android:layout_width="62dp"
            android:layout_height="38dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_nav_indicator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navToday"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navTodayIcon"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="@string/nav_today"
                    android:src="@drawable/ic_drop" />

                <TextView
                    android:id="@+id/navTodayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/nav_today"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navHistoryIcon"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="@string/nav_history"
                    android:src="@drawable/ic_chart" />

                <TextView
                    android:id="@+id/navHistoryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/nav_history"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
